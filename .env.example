# Copie este arquivo para .env e ajuste os valores (o .env NÃO deve ser enviado ao Git).
# Não use aspas, nem os caracteres # e ; no valor da senha.
APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=meu_calendario_academico
DB_USER=postgres
DB_PASSWORD=troque_esta_senha

# --- Sincronização com o planejamento do Moodle ---
# Pasta (relativa ao projeto ou caminho absoluto) com um CSV por disciplina.
MOODLE_PASTA=moodle_simulado
# Minutos sem sincronizar para o sistema sincronizar sozinho quando o estudante entra.
SYNC_INTERVALO_MIN=30

# --- Somente para o script de instalação (contas de demonstração locais) ---
DEMO_SENHA=demo1234
